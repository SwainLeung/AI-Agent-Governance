{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed AI Agent project state",
  "type": "object",
  "required": ["schema_version", "project_id", "stage", "status", "owner", "generated_at", "evidence", "next_action"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "stage": {"enum": ["intent", "scoped", "planned", "executing", "evidence_ready", "human_review", "approved_sample", "approved_full", "changes_requested", "rejected", "deploy", "verify", "observe", "sample_observed", "expanded", "adjusted", "rolled_back", "blocked", "recovery"]},
    "status": {"enum": ["pass", "warn", "blocked", "unknown", "stale", "not_applicable"]},
    "owner": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
    "freshness_ttl_hours": {"type": "number", "exclusiveMinimum": 0},
    "run_id": {"type": ["string", "null"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "failure": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "owner": {"type": "string"},
        "unblock_action": {"type": "string"},
        "next_review_at": {"type": "string", "format": "date-time"}
      }
    },
    "reconciliation": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["not_run", "matched", "drift", "unknown"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": "string"}
      }
    },
    "metrics": {"type": "object"},
    "decision": {"type": ["object", "null"]},
    "rollback_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
